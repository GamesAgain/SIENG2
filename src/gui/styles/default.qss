/* --- Global --- */
QWidget {
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* --- Text selection context menu --- */
QMenu {
    background-color: #252525;
    color: #FFFFFF;
    border: 1px solid #343434;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    color: #FFFFFF;
    padding: 5px 22px 5px 8px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1C292F;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #343434;
    margin: 4px 6px;
}

/* --- Dropdown Style (Picture Type / Add Frame) ---*/
QComboBox {
    background-color: #252525;
    border: 1px solid rgba(56, 189, 248, 0.20);
    border-radius: 6px;
    padding: 6px 10px;
    color: #e2e8f0;
    font-size: 9pt;
}
QComboBox:hover {
    border: 1px solid #38bdf8;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: url(src/gui/assets/svg/chevron-down.svg);
    width: 12px;
    height: 12px;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #252525;
    border: 1px solid #343434;
    selection-background-color: rgba(56, 189, 248, 0.2);
    color: #e2e8f0;
    outline: none;
}

/* -- Check Box Style -- */
QCheckBox {
    color: #CBD5E1;
    spacing: 9px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: #252525;
    border: 1px solid #3A4650;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #38BDF8;
}

QCheckBox::indicator:checked {
    background-color: #38BDF8;
    border-color: #38BDF8;
    image: url(src/gui/assets/svg/check.svg);
}

/* --- Window form --- */
QFrame#windowForm {
    background-color: #1E1E1E;
    border: 1px solid #282828;     
    border-radius: 6px; 
    color: #64748B;
}

/* --- SIENG2 Title Bar --- */
QFrame#appTitleBar {
    background-color: #181818;
    border: none;
    border-bottom: 1px solid #1C3039;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* --- SIENG2 Logo --- */
QLabel#logoMark {
    background-color: transparent;
    border: none;
}

/* --- SIENG2 Title --- */
QLabel#appTitle {
    font-family: "Courier New";
    font-size: 15pt;
    font-weight: 700;
    letter-spacing: 2px;
    color: #E2E8F0;
    background-color: transparent;
    border: none;
}

/* --- SIENG2 SubTitle --- */
QLabel#appSubtitle {
    font-family: "Courier New";
    font-size: 7.5pt;
    color: #536072;
    letter-spacing: 1px;
    background-color: transparent;
    border: none;
}

/* --- Window Control Buttons --- */
QPushButton#controlWindowBtn,
QPushButton#closeWindowBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    font-size: 10.5pt;
    color: #E2E8F0;
}

QPushButton#controlWindowBtn:hover {
    background-color: #2F2F2F;
    color: #FFFFFF;
}

/* --- Close Button Hover --- */
QPushButton#closeWindowBtn:hover {
    background-color: #F43F5E;
    color: #FFFFFF;
}

/* --- Sidebar ด้านซ้าย --- */
QFrame#sidebar {
    background-color: #181818;
    border-right: 1px solid #282828;
    border-bottom-left-radius: 6px;
}

/* Label แบ่ง section (Steganography, Steganalysis, utility) */
QLabel#sectionLabel {
    color: #515D6E; 
    font-family: "Courier New", monospace;
    font-size: 7.5pt; 
    font-weight: bold; 
    letter-spacing: 1px; 
    padding: 0px 6px;
    border: none;
}

/* --- SIDEBAR BUTTONS --- */
/* Normal state */
QPushButton#sidebarButton {
    font-family: 'Segoe UI', sans-serif;
    text-align: left;
    padding: 7px 10px;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #818D9F;
    font-size: 9pt;
    font-weight: 500;
}

/* Hover state */
QPushButton#sidebarButton:hover {
    background-color: #252525;
    color: #E2E7EF;
}

/* Checked/Active state (ใช้ setCheckable(True)) */
QPushButton#sidebarButton:checked {
    background-color: #1C292F;
    color: #38BDF8;
    border: 1px solid #224A5B;
}


/* --- Card Style --- */
QFrame#card {
    background-color: #252525;
    border: 1px solid #343434;
    border-radius: 10px;
}

QLabel#cardTitle {
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: #CBD5E1;
}


/* --- Standalone execution status and progress --- */
QProgressBar#loadingIndicator {
    background-color: #333333;
    border: 1px solid rgba(56, 189, 248, 0.20);
    border-radius: 4px;
}

QProgressBar#loadingIndicator::chunk {
    background-color: #38bdf8;
    border-radius: 4px;
}

QLabel#statusLabel {
    font-size: 11px;
    color: #94A3B8;
}

/* --- Saved key picker (reference styles) --- */
QPushButton#KeyLibraryBtn {
    background-color: #1C292F;
    border: 1px solid #224A5B;
    border-radius: 6px;
    color: #38BDF8;
    font-size: 11px;
    font-weight: 600;
    padding: 7px 12px;
}

QPushButton#KeyLibraryBtn:hover {
    background-color: #21353F;
    border-color: #38BDF8;
}

QPushButton#KeyLibraryBtn:pressed {
    background-color: #17252B;
}

QPushButton#KeyLibraryBtn:disabled {
    background-color: transparent;
    color: #52525B;
    border-color: #2A2A2A;
}

/* --- Primary Action Button ---
(ลงมือทำ action หลักของแต่ละหน้า เช่น Embed Data, Extract Data, Save Metadata) */
QPushButton#PrimaryActionBtn {
    background-color: rgba(56, 189, 248, 0.1); /* สีฟ้าโปร่งใส 10% */
    color: #38bdf8; /* ตัวหนังสือสีฟ้า */
    font-weight: 700;
    font-size: 9.75pt;
    padding: 8px 24px;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.5); /* ขอบสีฟ้าจางๆ */
}

QPushButton#PrimaryActionBtn:hover {
    background-color: rgba(56, 189, 248, 0.2);
    border: 1px solid #38bdf8; /* ขอบสว่างขึ้น */
    color: #7dd3fc;
}

QPushButton#PrimaryActionBtn:pressed {
    background-color: #38bdf8; /* เติมสีเต็มตอนกด */
    color: #1e1e1e; /* ตัวหนังสือกลับเป็นสีดำ */
}

QPushButton#PrimaryActionBtn:disabled {
    background-color: transparent;
    color: #52525B;
    border: 1px solid #2A2A2A;
}


/* --- SecondaryButton --- 
(Cancel, Replace, Revert, Add Frame, Change File) */
QPushButton#SecondaryBtn {
    background-color: transparent;
    border: 1px solid #343434;
    border-radius: 6px;
    color: #94A3B8;
    font-size: 8.25pt;
    font-weight: 500;
    padding: 7px 14px;
}
QPushButton#SecondaryBtn:hover {
    border: 1px solid #38bdf8;
    color: #E2E8F0;
}
QPushButton#SecondaryBtn:pressed {
    background-color: rgba(56, 189, 248, 0.15);
}
QPushButton#SecondaryBtn:disabled,
QPushButton#DangerBtn:disabled {
    color: #52525B;          /* จางลงให้เห็นชัดว่ากดไม่ได้ (เช่น Save Outputs ก่อน run) */
    border: 1px solid #2A2A2A;
}

/* SecondaryBtn variant: ตัวหนังสือสีขาว (เช่น Import Config) */
QPushButton#SecondaryBtn[textColor="white"] {
    color: #FFFFFF;
}
QPushButton#SecondaryBtn[textColor="white"]:disabled {
    color: #52525B;          /* disabled ชนะ textColor=white — ไม่งั้นจะดูเหมือนกดได้ */
}

QPushButton#SecondaryBtn[accent="green"] {
    color: #34D399;
    border: 1px solid #2D7655;
}
QPushButton#SecondaryBtn[accent="green"]:hover {
    color: #6EE7B7;
    border-color: #34D399;
}

QPushButton#SecondaryBtn[accent="green"]:disabled {
    color: #52525B;
    border-color: #2A2A2A;
}

/* --- Danger Button ---
ขอบปุ่มกับตัวหนังสือสีแดง bg โปร่งใส*/
QPushButton#DangerBtn {
    background-color: transparent;
    border: 1px solid rgba(244, 63, 94, 0.45);
    border-radius: 6px;
    color: #FB7185;
    font-size: 8.25pt;
    padding: 7px 12px;
}

QPushButton#DangerBtn:hover {
    background-color: rgba(244, 63, 94, 0.12);
    border-color: #F43F5E;
}

/* --- PlainTextEdit Style --- */
QPlainTextEdit#payloadTextArea {
    background-color: #2E2E2E;
    border: 1px solid #304B57; 
    border-radius: 6px;
    padding: 7px 10px;
    color: #e2e8f0;
    font-family: 'Courier New', monospace; 
    font-size: 10.5pt;
}

/* เวลาผู้ใช้คลิกพิมพ์ให้ขอบเป็นสีฟ้า */
QPlainTextEdit#payloadTextArea:focus {
    border: 1px solid #38bdf8;
}

/* --- Payload capacity --- */
QLabel#keyValidationLabel {
    font-family: 'Courier New', monospace;
    font-size: 10px;
    padding: 2px 0;
}

QLabel#keyValidationLabel[keyState="valid"] {
    color: #34D399;
}

QLabel#keyValidationLabel[keyState="pending"] {
    color: #F59E0F;
}

QLabel#keyValidationLabel[keyState="error"] {
    color: #EF4444;
}

QLabel#capacityLabel {
    font-family: 'Courier New', monospace;
    font-size: 10px;
    color: #94A3B8;
}

QLabel#capacityLabel[capacityState="warning"] {
    color: #F59E0F;
}

QLabel#capacityLabel[capacityState="danger"] {
    color: #f43f5e;
}


/* สไตล์สำหรับ Label (.form-label) */
QLabel#formLabel {
    font-size: 8.25pt;
    color: #94a3b8;
    font-weight: 500;
}

QLabel#dialogFormLabel {
    color: #e2e8f0;
}


/* สไตล์สำหรับช่องกรอกข้อความ (.form-input) */
QLineEdit#formInput {
    background-color: #252525;
    border: 1px solid rgba(56, 189, 248, 0.20);
    border-radius: 6px;
    padding: 7px 10px;
    color: #e2e8f0;
    font-size: 9pt;
}

/* สไตล์ตอนที่คลิกพิมพ์ (focus) */
QLineEdit#formInput:focus {
    border: 1px solid #38bdf8;
}

/* ข้อความ hint เล็ก ๆ  */
QLabel#hintLabel {
    color: #64748B;
    font-size: 7.5pt;
}

/* --- Key Management --- */
QLabel#pageTitle {
    color: #E2E8F0;
    font-size: 15pt;
    font-weight: 700;
}
QLabel#pageTitle[compactTitle="true"] {
    font-size: 16px;
}

QListWidget#keyList{
    background-color: #1E1E1E;
    color: #CBD5E1;
    border: 1px solid #343434;
    border-radius: 7px;
    outline: none;
    padding: 4px;
}

QListWidget#keyList::item{
    padding: 10px;
    border-bottom: 1px solid #303030;
}

QListWidget#keyList::item:hover{
    background-color: #252F33;
}

QListWidget#keyList::item:selected{
    background-color: #1C292F;
    color: #38BDF8;
    border: 1px solid #224A5B;
    border-radius: 5px;
}

QFrame#keyListItemContent {
    background-color: transparent;
    border: none;
}

QLabel#keyDetailValue {
    color: #CBD5E1;
    font-family: 'Courier New', monospace;
    font-size: 8.25pt;
}

QPushButton#CopyFingerprintBtn {
    background-color: #252525;
    border: 1px solid #343434;
    border-radius: 4px;
    color: #64748B;
    font-size: 7.5pt;
    font-weight: 500;
    padding: 3px 9px;
}

QPushButton#CopyFingerprintBtn:hover {
    background-color: #2A2A2A;
    border-color: #475569;
    color: #94A3B8;
}

QPushButton#CopyFingerprintBtn:pressed {
    background-color: #1E1E1E;
    border-color: #38BDF8;
    color: #CBD5E1;
}

QPushButton#CopyFingerprintBtn:disabled {
    background-color: #222222;
    border-color: #2A2A2A;
    color: #52525B;
}

QLabel#keyListSummary {
    color: #64748B;
    font-size: 10px;
}

QLabel#keyListDisplayName {
    color: #E2E8F0;
    font-size: 12px;
    font-weight: 700;
}

QLabel#keyListDisplayName[selected="true"] {
    color: #7DD3FC;
}

QLabel#keyListSummary[selected="true"] {
    color: #8FB4C8;
}

QDialog QLabel {
    color: #CBD5E1;
}

QDialog QPushButton {
    color: #CBD5E1;
}

/* --- Analyzer parameters dialog (scoped to avoid other pages) --- */
QDialog#analysisParametersDialog {
    background-color: #252525;
}

QDialog#analysisParametersDialog QLabel#analysisParameterTitle {
    color: #E2E8F0;
    font-size: 17px;
    font-weight: 700;
}

QDialog#analysisParametersDialog QLabel#analysisParameterDescription,
QDialog#analysisParametersDialog QLabel#analysisParameterNote {
    color: #94A3B8;
    font-size: 11px;
}

QDialog#analysisParametersDialog QLabel#analysisParameterLabel {
    color: #AAB8C8;
    font-size: 11px;
    font-weight: 500;
}

QDialog#analysisParametersDialog QSpinBox#analysisParameterInput,
QDialog#analysisParametersDialog QDoubleSpinBox#analysisParameterInput {
    background-color: #292D30;
    border: 1px solid #40505B;
    border-radius: 7px;
    color: #E2E8F0;
    font-size: 12px;
    min-height: 24px;
    padding: 7px 10px;
    selection-background-color: #24617A;
}

QDialog#analysisParametersDialog QSpinBox#analysisParameterInput:focus,
QDialog#analysisParametersDialog QDoubleSpinBox#analysisParameterInput:focus {
    border-color: #38BDF8;
}

QDialog#analysisParametersDialog QLabel#analysisParameterError {
    color: #FB7185;
    background-color: rgba(244, 63, 94, 0.08);
    border: 1px solid rgba(244, 63, 94, 0.35);
    border-radius: 5px;
    font-size: 11px;
    padding: 6px 9px;
}

/* --- Analyzer file selection --- */
QFrame#fileDropZone {
    background-color: #1E1E1E;
    border: 1.5px dashed #1E3945;
    border-radius: 8px;
}

QFrame#fileDropZone[hasFile="false"]:hover,
QFrame#fileDropZone[isDragging="true"] {
    background-color: #262D30;
    border: 1.5px dashed #38BDF8;
}

QFrame#fileDropZone[hasFile="true"] {
    border: 1.5px solid #262D30;
}

QFrame#fileDropZone[hasFile="true"]:hover {
    background-color: #262D30;
    border: 1.5px solid #38BDF8;
}

QScrollArea#fileListScroll {
    border: none;
    background-color: transparent;
}

QWidget#fileListContainer {
    background-color: transparent;
}

QScrollArea#fileListScroll QScrollBar:horizontal {
    height: 0px;
}

QFrame#fileItemRow {
    background-color: #2A2A2D;
    border: 1px solid #3D3D40;
    border-radius: 6px;
}

QFrame#fileItemRow:hover {
    background-color: #333336;
    border: 1px solid #38BDF8;
}

QLabel#fileItemName {
    color: #E2E8F0;
    font-size: 12px;
    font-weight: 600;
}

QLabel#fileItemSize {
    color: #94A3B8;
    font-size: 10px;
    font-family: 'Courier New', monospace;
}

QPushButton#btnRemoveFile {
    background-color: transparent;
    border: none;
    border-radius: 4px;
}

QPushButton#btnRemoveFile:hover {
    background-color: rgba(244, 63, 94, 0.1);
    border: 1px solid #7e3340;
}

QPushButton#btnRemoveFile:pressed {
    background-color: rgba(244, 63, 94, 0.2);
}

QLabel#mainLabel {
    color: #CBD5E1;
    font-size: 12px;
    font-weight: 600;
}

QLabel#subLabel {
    font-family: 'Courier New', monospace;
    color: #94A3B8;
    font-size: 10px;
}

/* Attached picture cards (reference styles) */
QFrame#apicCard {
    background-color: #252525;
    border: 1px solid #343434;
    border-radius: 8px;
}

QFrame#apicPreview {
    border-radius: 8px 8px 0px 0px;
}
QFrame#apicPreview[tintColor="blue"] { background-color: rgba(56, 189, 248, 0.12); }
QFrame#apicPreview[tintColor="purple"] { background-color: rgba(167, 139, 250, 0.12); }
QFrame#apicPreview[tintColor="green"] { background-color: rgba(52, 211, 153, 0.12); }
QFrame#apicPreview[tintColor="orange"] { background-color: rgba(245, 158, 15, 0.12); }

QFrame#fileInfoCard {
    background-color: #252525;
    border: 1px solid #304B57;
    border-radius: 10px;
}

QFrame#fileInfoIconBox {
    background-color: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 8px;
}

QLabel#fileInfoName {
    color: #E2E8F0;
    font-size: 13px;
    font-weight: 700;
}

QLabel#fileInfoDetail {
    color: #94A3B8;
    font-family: 'Courier New', monospace;
    font-size: 10px;
}

QLabel#fileInfoBadge {
    color: #94A3B8;
    background-color: rgba(148, 163, 184, 0.08);
    border: 1px solid #343434;
    border-radius: 5px;
    padding: 3px 8px;
    font-family: 'Courier New', monospace;
    font-size: 10px;
    font-weight: 600;
}

QLabel#fileInfoBadge[badgeColor="blue"] {
    color: #38BDF8;
    background-color: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.5);
}

/* --- SIENG2 tabs (opt in with objectName="siengTabs") --- */
QTabWidget#siengTabs::pane {
    border: none;
    border-top: 1px solid #2E2E2E;
    top: -1px;
}

QTabWidget#siengTabs QTabBar::tab {
    background: transparent;
    color: #94A3B8;
    padding: 8px 14px;
    font-size: 12px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
}

QTabWidget#siengTabs QTabBar::tab:hover {
    color: #E2E8F0;
}

QTabWidget#siengTabs QTabBar::tab:selected {
    color: #38BDF8;
    border-bottom: 2px solid #38BDF8;
}

/* --- Bit Statistics overview --- */
QScrollArea#transparentScroll,
QWidget#transparentScrollContent,
QScrollArea#transparentScroll > QWidget > QWidget {
    background-color: transparent;
    border: none;
}

/* Floating web-style scrollbars shared by the SIENG2 interface. */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #4A4A4E;
    min-height: 32px;
    border-radius: 4px;
    border: none;
}

QScrollBar::handle:vertical:hover {
    background-color: #64748B;
}

QScrollBar::handle:vertical:pressed {
    background-color: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #4A4A4E;
    min-width: 32px;
    border-radius: 4px;
    border: none;
}

QScrollBar::handle:horizontal:hover {
    background-color: #64748B;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #94A3B8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

QLabel#statSectionTitle {
    color: #CBD5E1;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#channelButton {
    background: transparent;
    border: none;
    border-radius: 20px;
    color: #A3A3A3;
    font-size: 12px;
    font-weight: 600;
    min-height: 40px;
    padding: 0 22px;
}

QPushButton#channelButton:hover {
    color: #E2E8F0;
    background-color: #303030;
}

QPushButton#channelButton:checked {
    color: #E2E8F0;
    background-color: #3A3A3A;
}

QFrame#detectorCard {
    background-color: #1E1E1E;
    border: 1px solid #343434;
    border-radius: 10px;
}

QLabel#detectorTitle {
    color: #CBD5E1;
    font-size: 12px;
    font-weight: 600;
}

QLabel#detectorValue {
    color: #F1F5F9;
    font-family: 'Courier New', monospace;
    font-size: 36px;
    font-weight: 700;
}

QLabel#detectorValue[valueColor="green"] {
    color: #16A34A;
}

QLabel#detectorValue[valueColor="blue"] {
    color: #3B6FF5;
}

QLabel#detectorDetail {
    color: #94A3B8;
    font-family: 'Courier New', monospace;
    font-size: 10px;
}

/* --- Analyzer detector selector --- */
QPushButton#DetectorBtn {
    background: #242424;
    border: 1px solid #434343;
    border-radius: 9px;
    padding: 0;
}
QPushButton#DetectorBtn:hover {
    background: #292929;
}
QPushButton#DetectorBtn[detectorType="chi"]:checked {
    border-color: #38BDF8;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #202B30, stop:0.7 #202020);
}
QPushButton#DetectorBtn[detectorType="rs"]:checked {
    border-color: #32CA85;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #212D27, stop:0.7 #202020);
}
QPushButton#DetectorBtn[detectorType="spa"]:checked {
    border-color: #B47AFA;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2B2631, stop:0.7 #202020);
}
QPushButton#DetectorBtn QLabel {
    background: transparent;
    border: none;
    padding: 0;
}
QPushButton#DetectorBtn QLabel#detectorNameLabel {
    font-size: 14px;
    font-weight: 700;
}
QPushButton#DetectorBtn QLabel#detectorDescriptionLabel {
    color: #B5C2D2;
    font-size: 11px;
}
QPushButton#DetectorBtn QLabel#detectorBadge {
    font-size: 10px;
    border: 1px solid;
    border-radius: 9px;
    padding: 2px 7px;
}
QPushButton#DetectorBtn[detectorType="chi"] QLabel#detectorNameLabel,
QPushButton#DetectorBtn[detectorType="chi"] QLabel#detectorBadge {
    color: #38BDF8;
    border-color: #38BDF8;
}
QPushButton#DetectorBtn[detectorType="rs"] QLabel#detectorNameLabel,
QPushButton#DetectorBtn[detectorType="rs"] QLabel#detectorBadge {
    color: #32CA85;
    border-color: #32CA85;
}
QPushButton#DetectorBtn[detectorType="spa"] QLabel#detectorNameLabel,
QPushButton#DetectorBtn[detectorType="spa"] QLabel#detectorBadge {
    color: #B47AFA;
    border-color: #B47AFA;
}

/* --- Bit Statistics result layout --- */
QFrame#bitStatisticsResults {
    background: transparent;
    border: none;
}

QFrame#analysisEmptyState {
    background-color: transparent;
    border: none;
}

QLabel#analysisEmptyTitle {
    color: #CBD5E1;
    font-size: 14px;
    font-weight: 700;
}

QLabel#analysisEmptyHint {
    color: #718096;
    font-size: 11px;
}

QFrame#analysisDetailPanel,
QFrame#analysisSummaryCard,
QFrame#analysisContextCard {
    background-color: #232323;
    border: 1px solid #3B3B3B;
    border-radius: 9px;
}

QFrame#analysisDetailPanel {
    border-color: #315064;
}

QFrame#analysisDetailPanel[detectorType="rs"] {
    border-color: #295743;
}

QFrame#analysisDetailPanel[detectorType="spa"] {
    border-color: #594071;
}

QLabel#analysisPanelTitle {
    color: #E2E8F0;
    font-size: 14px;
    font-weight: 700;
}

QLabel#analysisPanelBadge {
    color: #A8C8D8;
    background-color: #2B2B2B;
    border: 1px solid #414141;
    border-radius: 9px;
    font-size: 10px;
    padding: 3px 8px;
}

QLabel#analysisFilterLabel {
    color: #B5C2D2;
    font-size: 11px;
}

QPushButton#analysisChannelButton {
    background-color: transparent;
    border: 1px solid #3B4650;
    border-radius: 15px;
    color: #94A3B8;
    font-size: 11px;
    font-weight: 600;
    min-height: 28px;
    padding: 0 14px;
}

QPushButton#analysisChannelButton:hover {
    border-color: #64748B;
    color: #E2E8F0;
}

QPushButton#analysisChannelButton:checked {
    background-color: #17445A;
    border-color: #38BDF8;
    color: #E0F2FE;
}

QFrame#analysisDetailTabs {
    background: transparent;
    border: none;
    border-bottom: 1px solid #3A3A3A;
}

QFrame#analysisWholeMetrics {
    background: transparent;
    border: none;
}

QLabel#analysisWholeMetricsTitle {
    color: #DCE6F1;
    font-size: 11px;
    font-weight: 700;
}

QLabel#analysisWholeMetricsScope {
    color: #8192A5;
    font-size: 9px;
}

QPushButton#analysisDetailTab {
    background-color: #292929;
    border: 1px solid #3B3B3B;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #AAB8C8;
    font-size: 10px;
    min-height: 31px;
    padding: 0 12px;
}

QPushButton#analysisDetailTab:hover {
    color: #E2E8F0;
    border-color: #52606D;
}

QPushButton#analysisDetailTab:checked {
    background-color: #20333C;
    border-color: #38BDF8;
    color: #38BDF8;
}

QFrame#analysisPlotPanel {
    background-color: #1E1E1E;
    border: 1px solid #363636;
    border-radius: 7px;
}

QLabel#analysisPlotTitle,
QLabel#analysisDataTitle {
    color: #DCE6F1;
    font-size: 11px;
    font-weight: 700;
}

QLabel#analysisPlotSubtitle,
QLabel#analysisLegendLabel {
    color: #8192A5;
    font-size: 10px;
}

QLabel#analysisNote {
    color: #9EB0C2;
    background-color: #242C31;
    border: 1px solid #34434C;
    border-radius: 6px;
    font-size: 10px;
    padding: 9px;
}

QFrame#analysisMetricTile {
    background-color: #292929;
    border: 1px solid #3B3B3B;
    border-radius: 6px;
}

QLabel#analysisMetricLabel {
    color: #8192A5;
    font-size: 9px;
}

QLabel#analysisMetricValue {
    color: #E2E8F0;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    font-weight: 700;
}

QLabel#analysisMetricValue[accent="true"] {
    color: #38BDF8;
}

QFrame#analysisDetailPanel[detectorType="rs"] QLabel#analysisMetricValue[accent="true"] {
    color: #32CA85;
}

QFrame#analysisDetailPanel[detectorType="spa"] QLabel#analysisMetricValue[accent="true"] {
    color: #B47AFA;
}

QTableWidget#analysisRawTable {
    background-color: #1F1F1F;
    alternate-background-color: #242424;
    border: 1px solid #383838;
    border-radius: 6px;
    color: #BAC7D5;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    gridline-color: #343434;
    outline: none;
}

QTableWidget#analysisRawTable::item {
    padding: 5px 7px;
}

QTableWidget#analysisRawTable::item:selected {
    background-color: #214456;
    color: #E2E8F0;
}

QTableWidget#analysisRawTable QHeaderView::section {
    background-color: #292929;
    border: none;
    border-right: 1px solid #3B3B3B;
    border-bottom: 1px solid #3B3B3B;
    color: #94A3B8;
    font-family: 'Segoe UI', sans-serif;
    font-size: 12px;
    font-weight: 600;
    padding: 6px;
}

QTableWidget#analysisRawTable QTableCornerButton::section {
    background-color: #292929;
    border: none;
}

QFrame#analysisSummaryColumn {
    background: transparent;
    border: none;
}

QFrame#analysisSummaryCard[detectorType="chi_square"] {
    border-color: #315064;
}

QFrame#analysisSummaryCard[detectorType="rs"] {
    border-color: #295743;
}

QFrame#analysisSummaryCard[detectorType="spa"] {
    border-color: #594071;
}

QLabel#analysisSummaryTitle {
    color: #DCE6F1;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#analysisOpenDetector {
    background: transparent;
    border: 1px solid #3E4650;
    border-radius: 10px;
    color: #AAB8C8;
    font-size: 9px;
    padding: 3px 8px;
}

QPushButton#analysisOpenDetector:hover {
    border-color: #38BDF8;
    color: #38BDF8;
}

QLabel#analysisSummaryLabel {
    color: #8192A5;
    font-size: 9px;
}

QLabel#analysisSummaryValue {
    color: #E2E8F0;
    font-family: 'Courier New', monospace;
    font-size: 10px;
    font-weight: 700;
}

QLabel#analysisRSSummaryLegend {
    color: #B8C5D5;
    font-size: 11px;
}

QFrame#analysisSummaryMetrics {
    background: transparent;
    border: none;
    border-top: 1px solid #3B3B3B;
    border-radius: 0;
}

QFrame#analysisSummaryMetric {
    background: transparent;
    border: none;
    border-radius: 0;
}

QFrame#analysisSummaryMetric[divider="true"] {
    border-right: 1px solid #3C3C3C;
}

QLabel#analysisSummaryMetricLabel {
    color: #98A8BF;
    font-size: 10px;
}

QLabel#analysisSummaryMetricValue {
    color: #E2E8F0;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 18px;
    font-weight: 700;
}

QLabel#analysisSummaryMetricValue[accent="green"] {
    color: #32CA85;
}

QLabel#analysisSummaryMetricValue[accent="cyan"] {
    color: #38BDF8;
}

QLabel#analysisSummaryMetricValue[accent="purple"] {
    color: #B47AFA;
}

QLabel#analysisChiSquareEvidence {
    color: #8294A6;
    font-size: 9px;
}

QLabel#analysisChiSquareEvidence[evidenceState="clear"] {
    color: #7DD3FC;
}

QLabel#analysisSummaryPairValue {
    color: #E2E8F0;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 12px;
    font-weight: 700;
}

QLabel#analysisRSSnapshot {
    color: #AEBED0;
    background: #2D2D2D;
    border: 1px solid #434343;
    border-radius: 7px;
    padding: 10px;
    font-size: 11px;
}

QLabel#analysisSPASummaryLegend,
QLabel#analysisSummaryHint {
    color: #8294A6;
    font-size: 8px;
}

QLabel#analysisContextText {
    color: #8FA2B5;
    font-family: 'Courier New', monospace;
    font-size: 9px;
    line-height: 1.4;
}

#selectionToggle {
    background-color: #252525;
    border-radius: 8px;
    border: 1px solid #343434;
}

/* Selection toggle variants: standalone, configurable, source, password, public_key */
#selectionToggleBtn {
    font-family: Arial, sans-serif;
    background-color: transparent;
    border: none;
    color: #94A3B8;
    font-size: 12px;
    padding: 7px 12px;
    font-weight: 500;
}

#selectionToggleBtn[variant="source"] {
    font-family: Arial, sans-serif;
    background-color: transparent;
    border: none;
    color: #94A3B8;
    font-size: 11px;
    padding: 5px 10px;
    font-weight: 500;
}

#selectionToggle[variant="encryption"] #selectionToggleBtn {
    padding: 5px 12px;
}

#selectionToggleBtn:checked[variant="standalone"] {
    background-color: #27343A;
    border: 1px solid #2C6077;
    border-radius: 6px;
    color: #38BDF8;
}

#selectionToggleBtn:checked[variant="source"] {
    background-color: #1C292F;
    border: 1px solid #224A5B;
    border-radius: 6px;
    color: #38BDF8;
}

#selectionToggleBtn:checked[variant="configurable"] {
    background-color: #433622;
    border: 1px solid #78551A;
    border-radius: 6px;
    color: #F59E0F;
}

#selectionToggleBtn:checked[variant="password"] {
    background-color: #3F3B4B;
    border: 1px solid #7464A2;
    border-radius: 6px;
    color: #A78BFA;
}

#selectionToggleBtn:checked[variant="public_key"] {
    background-color: #213B33;
    border: 1px solid #3B8766;
    border-radius: 6px;
    color: #34D399;
}

/* --- Pipeline Chip Buttons (ปุ่มเพิ่ม technique / Clear ใน Pipeline Builder) --- */
/* base shape ใช้ร่วมกันทุกสี ต่างกันแค่ accentColor */
QPushButton#ChipBtn {
    font-family: 'Segoe UI', sans-serif;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 14px;
}

QPushButton#ChipBtn[accentColor="blue"] {
    background-color: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.5);
    color: #38BDF8;
}
QPushButton#ChipBtn[accentColor="blue"]:hover {
    background-color: rgba(56, 189, 248, 0.2);
    border: 1px solid #38BDF8;
}

QPushButton#ChipBtn[accentColor="purple"] {
    background-color: rgba(167, 139, 250, 0.1);
    border: 1px solid rgba(167, 139, 250, 0.5);
    color: #A78BFA;
}
QPushButton#ChipBtn[accentColor="purple"]:hover {
    background-color: rgba(167, 139, 250, 0.2);
    border: 1px solid #A78BFA;
}

QPushButton#ChipBtn[accentColor="orange"] {
    background-color: rgba(245, 158, 15, 0.1);
    border: 1px solid rgba(245, 158, 15, 0.5);
    color: #F59E0F;
}
QPushButton#ChipBtn[accentColor="orange"]:hover {
    background-color: rgba(245, 158, 15, 0.2);
    border: 1px solid #F59E0F;
}

QPushButton#ChipBtn[accentColor="red"] {
    background-color: rgba(244, 63, 94, 0.1);
    border: 1px solid rgba(244, 63, 94, 0.5);
    color: #f43f5e;
}
QPushButton#ChipBtn[accentColor="red"]:hover {
    background-color: rgba(244, 63, 94, 0.2);
    border: 1px solid #f43f5e;
}



/* --- Configurable Pipeline builder GUI --- */
QFrame#pipelineCanvas {
    background-color: #1E1E1E;
    border: 1px solid #343434;
    border-radius: 8px;
}

QScrollArea#pipelineScroll {
    border: none;
    background-color: transparent;
}
QWidget#pipelineScrollContent {
    background-color: transparent;
}

QLabel#stepConfigUI {
    color: #64748B;
    font-family: 'Courier New', monospace;
    font-size: 10px;
}

QLabel#pipelineEmpty {
    color: #64748B;
    font-size: 12px;
}

QPushButton#stepUiBtn {
    background-color: #2D2D2D;
    border: 1px solid #343434;
    border-radius: 6px;
    color: #94A3B8;
    font-size: 11px;
    padding: 5px 12px;
}
QPushButton#stepUiBtn:checked {
    background-color: #1C292F;
    border: 1px solid #224A5B;
    color: #38BDF8;
}
QPushButton#stepUiBtn:disabled {
    color: #52525B;
}


/* --- Configurable Pipeline StepCards and flow canvas --- */
QFrame#stepCard {
    background-color: #252525;
    border: 1px solid #343434;
    border-radius: 10px;
}

QFrame#stepCard[accentColor="blue"]   { border-left: 3px solid #38BDF8; }

QFrame#stepCard[accentColor="purple"] { border-left: 3px solid #A78BFA; }

QFrame#stepCard[accentColor="orange"] { border-left: 3px solid #F59E0F; }

QLabel#stepCardTitle {
    font-family: 'Courier New', monospace;
    font-weight: 700;
    font-size: 14px;
    background: transparent;
    border: none;
}

QLabel#stepCardTitle[accentColor="blue"]   { color: #38BDF8; }

QLabel#stepCardTitle[accentColor="purple"] { color: #A78BFA; }

QLabel#stepCardTitle[accentColor="orange"] { color: #F59E0F; }

QLabel#stepCardNumber {
    color: #CBD5E1;
    font-family: 'Courier New', monospace;
    font-size: 11px;
    font-weight: 700;
    background: transparent;
    border: none;
}

QLabel#stepCardStatus {
    background-color: transparent;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 5px;
}

QLabel#stepCardStatus[state="setup"] {
    color: #F59E0F;
    background-color: rgba(245, 158, 15, 0.08);
    border: 1px solid rgba(245, 158, 15, 0.65);
}

QLabel#stepCardSub {
    color: #94A3B8;
    font-size: 11px;
    background: transparent;
    border: none;
}

QLabel#pipelineSummary {
    color: #64748B;
    font-family: 'Courier New', monospace;
    font-size: 12px;
}

QScrollArea#pipelineCanvasScroll {
    background-color: transparent;
    border: none;
}

QWidget#pipelineCanvasContent {
    background-color: transparent;
}

/* Floating StepCard removal button, shown only while hovering the card. */
QPushButton#stepCloseBtn {
    background-color: #F43F5E;
    border: 2px solid #1E1E1E;
    border-radius: 12px;
    padding: 0;
}
QPushButton#stepCloseBtn:hover {
    background-color: #FF5577;
}
