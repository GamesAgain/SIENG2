/* --- Global --- */
QWidget {
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* --- Text selection context menu --- */
QMenu {
    background-color: #252525;
    color: #FFFFFF;
    border: 1px solid #343434;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    color: #FFFFFF;
    padding: 5px 22px 5px 8px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #1C292F;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #343434;
    margin: 4px 6px;
}

/* --- Dropdown Style (Picture Type / Add Frame) ---*/
QComboBox {
    background-color: #252525;
    border: 1px solid rgba(56, 189, 248, 0.20);
    border-radius: 6px;
    padding: 6px 10px;
    color: #e2e8f0;
    font-size: 9pt;
}
QComboBox:hover {
    border: 1px solid #38bdf8;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: url(src/gui/assets/svg/chevron-down.svg);
    width: 12px;
    height: 12px;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #252525;
    border: 1px solid #343434;
    selection-background-color: rgba(56, 189, 248, 0.2);
    color: #e2e8f0;
    outline: none;
}

/* -- Check Box Style -- */
QCheckBox {
    color: #CBD5E1;
    spacing: 9px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: #252525;
    border: 1px solid #3A4650;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #38BDF8;
}

QCheckBox::indicator:checked {
    background-color: #38BDF8;
    border-color: #38BDF8;
    image: url(src/gui/assets/svg/check.svg);
}

/* --- Window form --- */
QFrame#windowForm {
    background-color: #1E1E1E;
    border: 1px solid #282828;     
    border-radius: 6px; 
    color: #64748B;
}

/* --- SIENG2 Title Bar --- */
QFrame#appTitleBar {
    background-color: #181818;
    border: none;
    border-bottom: 1px solid #1C3039;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* --- SIENG2 Logo --- */
QLabel#logoMark {
    background-color: transparent;
    border: none;
}

/* --- SIENG2 Title --- */
QLabel#appTitle {
    font-family: "Courier New";
    font-size: 15pt;
    font-weight: 700;
    letter-spacing: 2px;
    color: #E2E8F0;
    background-color: transparent;
    border: none;
}

/* --- SIENG2 SubTitle --- */
QLabel#appSubtitle {
    font-family: "Courier New";
    font-size: 7.5pt;
    color: #536072;
    letter-spacing: 1px;
    background-color: transparent;
    border: none;
}

/* --- Window Control Buttons --- */
QPushButton#controlWindowBtn,
QPushButton#closeWindowBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    font-size: 10.5pt;
    color: #E2E8F0;
}

QPushButton#controlWindowBtn:hover {
    background-color: #2F2F2F;
    color: #FFFFFF;
}

/* --- Close Button Hover --- */
QPushButton#closeWindowBtn:hover {
    background-color: #F43F5E;
    color: #FFFFFF;
}

/* --- Sidebar ด้านซ้าย --- */
QFrame#sidebar {
    background-color: #181818;
    border-right: 1px solid #282828;
    border-bottom-left-radius: 6px;
}

/* Label แบ่ง section (Steganography, Steganalysis, utility) */
QLabel#sectionLabel {
    color: #515D6E; 
    font-family: "Courier New", monospace;
    font-size: 7.5pt; 
    font-weight: bold; 
    letter-spacing: 1px; 
    padding: 0px 6px;
    border: none;
}

/* --- SIDEBAR BUTTONS --- */
/* Normal state */
QPushButton#sidebarButton {
    font-family: 'Segoe UI', sans-serif;
    text-align: left;
    padding: 7px 10px;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #818D9F;
    font-size: 9pt;
    font-weight: 500;
}

/* Hover state */
QPushButton#sidebarButton:hover {
    background-color: #252525;
    color: #E2E7EF;
}

/* Checked/Active state (ใช้ setCheckable(True)) */
QPushButton#sidebarButton:checked {
    background-color: #1C292F;
    color: #38BDF8;
    border: 1px solid #224A5B;
}


/* --- Card Style --- */
QFrame#card {
    background-color: #252525;
    border: 1px solid #343434;
    border-radius: 10px;
}

QLabel#cardTitle {
    font-family: "Segoe UI", sans-serif;
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: #CBD5E1;
}


/* --- Primary Action Button ---
(ลงมือทำ action หลักของแต่ละหน้า เช่น Embed Data, Extract Data, Save Metadata) */
QPushButton#PrimaryActionBtn {
    background-color: rgba(56, 189, 248, 0.1); /* สีฟ้าโปร่งใส 10% */
    color: #38bdf8; /* ตัวหนังสือสีฟ้า */
    font-weight: 700;
    font-size: 9.75pt;
    padding: 8px 24px;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.5); /* ขอบสีฟ้าจางๆ */
}

QPushButton#PrimaryActionBtn:hover {
    background-color: rgba(56, 189, 248, 0.2);
    border: 1px solid #38bdf8; /* ขอบสว่างขึ้น */
    color: #7dd3fc;
}

QPushButton#PrimaryActionBtn:pressed {
    background-color: #38bdf8; /* เติมสีเต็มตอนกด */
    color: #1e1e1e; /* ตัวหนังสือกลับเป็นสีดำ */
}

QPushButton#PrimaryActionBtn:disabled {
    background-color: transparent;
    color: #52525B;
    border: 1px solid #2A2A2A;
}


/* --- SecondaryButton --- 
(Cancel, Replace, Revert, Add Frame, Change File) */
QPushButton#SecondaryBtn {
    background-color: transparent;
    border: 1px solid #343434;
    border-radius: 6px;
    color: #94A3B8;
    font-size: 8.25pt;
    font-weight: 500;
    padding: 7px 14px;
}
QPushButton#SecondaryBtn:hover {
    border: 1px solid #38bdf8;
    color: #E2E8F0;
}
QPushButton#SecondaryBtn:pressed {
    background-color: rgba(56, 189, 248, 0.15);
}
QPushButton#SecondaryBtn:disabled,
QPushButton#DangerBtn:disabled {
    color: #52525B;          /* จางลงให้เห็นชัดว่ากดไม่ได้ (เช่น Save Outputs ก่อน run) */
    border: 1px solid #2A2A2A;
}

/* SecondaryBtn variant: ตัวหนังสือสีขาว (เช่น Import Config) */
QPushButton#SecondaryBtn[textColor="white"] {
    color: #FFFFFF;
}
QPushButton#SecondaryBtn[textColor="white"]:disabled {
    color: #52525B;          /* disabled ชนะ textColor=white — ไม่งั้นจะดูเหมือนกดได้ */
}

/* --- Danger Button ---
ขอบปุ่มกับตัวหนังสือสีแดง bg โปร่งใส*/
QPushButton#DangerBtn {
    background-color: transparent;
    border: 1px solid rgba(244, 63, 94, 0.45);
    border-radius: 6px;
    color: #FB7185;
    font-size: 8.25pt;
    padding: 7px 12px;
}

QPushButton#DangerBtn:hover {
    background-color: rgba(244, 63, 94, 0.12);
    border-color: #F43F5E;
}

/* --- PlainTextEdit Style --- */
QPlainTextEdit#payloadTextArea {
    background-color: #2E2E2E;
    border: 1px solid #304B57; 
    border-radius: 6px;
    padding: 7px 10px;
    color: #e2e8f0;
    font-family: 'Courier New', monospace; 
    font-size: 10.5pt;
}

/* เวลาผู้ใช้คลิกพิมพ์ให้ขอบเป็นสีฟ้า */
QPlainTextEdit#payloadTextArea:focus {
    border: 1px solid #38bdf8;
}


/* สไตล์สำหรับ Label (.form-label) */
QLabel#formLabel {
    font-size: 8.25pt;
    color: #94a3b8;
    font-weight: 500;
}

QLabel#dialogFormLabel {
    color: #e2e8f0;
}


/* สไตล์สำหรับช่องกรอกข้อความ (.form-input) */
QLineEdit#formInput {
    background-color: #252525;
    border: 1px solid rgba(56, 189, 248, 0.20);
    border-radius: 6px;
    padding: 7px 10px;
    color: #e2e8f0;
    font-size: 9pt;
}

/* สไตล์ตอนที่คลิกพิมพ์ (focus) */
QLineEdit#formInput:focus {
    border: 1px solid #38bdf8;
}

/* ข้อความ hint เล็ก ๆ  */
QLabel#hintLabel {
    color: #64748B;
    font-size: 7.5pt;
}

/* --- Key Management --- */
QLabel#pageTitle {
    color: #E2E8F0;
    font-size: 15pt;
    font-weight: 700;
}

QListWidget#keyList{
    background-color: #1E1E1E;
    color: #CBD5E1;
    border: 1px solid #343434;
    border-radius: 7px;
    outline: none;
    padding: 4px;
}

QListWidget#keyList::item{
    padding: 10px;
    border-bottom: 1px solid #303030;
}

QListWidget#keyList::item:hover{
    background-color: #252F33;
}

QListWidget#keyList::item:selected{
    background-color: #1C292F;
    color: #38BDF8;
    border: 1px solid #224A5B;
    border-radius: 5px;
}

QFrame#keyListItemContent {
    background-color: transparent;
    border: none;
}

QLabel#keyDetailValue {
    color: #CBD5E1;
    font-family: 'Courier New', monospace;
    font-size: 8.25pt;
}

QPushButton#CopyFingerprintBtn {
    background-color: #252525;
    border: 1px solid #343434;
    border-radius: 4px;
    color: #64748B;
    font-size: 7.5pt;
    font-weight: 500;
    padding: 3px 9px;
}

QPushButton#CopyFingerprintBtn:hover {
    background-color: #2A2A2A;
    border-color: #475569;
    color: #94A3B8;
}

QPushButton#CopyFingerprintBtn:pressed {
    background-color: #1E1E1E;
    border-color: #38BDF8;
    color: #CBD5E1;
}

QPushButton#CopyFingerprintBtn:disabled {
    background-color: #222222;
    border-color: #2A2A2A;
    color: #52525B;
}

QLabel#keyListSummary {
    color: #64748B;
    font-size: 10px;
}

QLabel#keyListDisplayName {
    color: #E2E8F0;
    font-size: 12px;
    font-weight: 700;
}

QLabel#keyListDisplayName[selected="true"] {
    color: #7DD3FC;
}

QLabel#keyListSummary[selected="true"] {
    color: #8FB4C8;
}

QDialog QLabel {
    color: #CBD5E1;
}

QDialog QPushButton {
    color: #CBD5E1;
}
